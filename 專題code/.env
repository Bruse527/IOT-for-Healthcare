# -----------------------------------------------------------
# 核心與安全配置 (Core Settings)
# -----------------------------------------------------------
SECRET_KEY="YOUR_UNIQUE_STRONG_SECRET_KEY"      # 用於加密和安全操作，請使用強隨機字串
DATABASE_URL="sqlite:///./smart_elderly.db"     # SQLite 資料庫 URL (可替換為 PostgreSQL 或 MySQL)

# -----------------------------------------------------------
# LINE Messaging API 配置 (Notification Service)
# -----------------------------------------------------------
LINE_CHANNEL_ID="YOUR_CHANNEL_ID"                # 頻道 ID
LINE_CHANNEL_SECRET="YOUR_CHANNEL_SECRET"        # 頻道密碼 (用於驗證 Webhook)
LINE_CHANNEL_ACCESS_TOKEN="YOUR_ACCESS_TOKEN"    # 存取權 (用於發送訊息)
TARGET_USER_ID="THE_RECIPIENT_LINE_USER_ID"      # 照護者/家屬的 LINE ID
WEBHOOK_URL="https://your-public-ip:8000/api/v1/line/webhook" # 您的 FastAPI 公網地址

# -----------------------------------------------------------
# 監測與系統運作配置 (System Operation)
# -----------------------------------------------------------
ALERT_TIMEOUT_MINUTES=12                        #  警報觸發後，等待確認（ACKNOWLEDGED）的最大時間 (分鐘)
FASTAPI_HOST="0.0.0.0"                          # FastAPI 監聽地址
FASTAPI_PORT=8000                               # FastAPI 監聽端口

# -----------------------------------------------------------
# IoT 設備配置 (ESP32 Firmware)
# -----------------------------------------------------------
DEVICE_ID="ESP32_RoomA"                         # 設備唯一 ID
WIFI_SSID="YOUR_WIFI_NAME"                      # Wi-Fi 名稱
WIFI_PASSWORD="YOUR_WIFI_PASSWORD"              # Wi-Fi 密碼
BACKEND_API_ADDRESS="http://[FastAPI_IP]:8000"  # ESP32 將資料 POST 到此 API 地址
